# Public — safe in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Absolute origin of this app (no trailing slash) — Supabase's
# resetPasswordForEmail requires an absolute redirectTo. e.g.
# http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=

# Server-only — never prefix with NEXT_PUBLIC_, never import outside
# src/server/**.
SUPABASE_SERVICE_ROLE_KEY=
